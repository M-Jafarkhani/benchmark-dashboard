FROM python:3.12-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app

# Refresh packages inherited from the base image (apk, not apt-get, on Alpine).
RUN apk update && apk upgrade --no-cache

COPY requirements.txt .

# build-base/etc. are only needed if pip has to compile a package from source
# (no musllinux wheel available for that pinned version). --virtual groups
# them so the whole toolchain can be removed again in one step, keeping the
# final image slim.
RUN apk add --no-cache --virtual .build-deps build-base musl-dev libffi-dev \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip uninstall -y pip \
    && apk del .build-deps

COPY --chown=10001:10001 app app

# The API needs no root privileges. A numeric user also avoids installing user
# management packages solely to create an account in the image.
USER 10001:10001

EXPOSE 9000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000"]